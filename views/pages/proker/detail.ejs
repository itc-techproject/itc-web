<% css = '<link rel="stylesheet" href="../css/proker.css">' %>

<section class="proker-main-container">
  <section class="proker-page-header">
    <h1><%= page.title %></h1>
    <p class="proker-page-description">
      <%= page.subtitle %>
    </p>
  </section>
  <main class="proker-content">
    <% if (page.layout === 'grid') { %>
      <%- include('./components/grid', { items: items }) %>
    <% } else if (page.layout === 'book') { %>
      <%- include('./components/book', { items: items }) %>
    <% } else if (page.layout === 'pure-timeline') { %>
      <%- include('./components/pure-timeline', { items: items }) %>
    <% } else if (page.layout === 'no-timeline') { %>
      <%- include('./components/no-timeline', { items: items }) %>
    <% } else if (page.layout === 'youtube') { %>
      <%- include('./components/youtube', { items: items }) %>
    <% } else if (page.layout === 'image') { %>
      <%- include('./components/image', { items: items }) %>
    <% } else { %>
      <p>Layout not found</p>
    <% } %>
  </main>
</section>
