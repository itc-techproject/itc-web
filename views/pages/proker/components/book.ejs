<div class="book-grid-container">
    <div class="book-grid">
        <% items.forEach(item => { %>
            <a href="<%= item.pdfUrl %>" target="_blank" rel="noopener noreferrer" class="book-card">
                <div class="book-cover">
                    <img 
                        src="<%= item.coverImage %>" 
                        alt="<%= item.title %>" 
                        loading="lazy"
                    >
                    <div class="book-overlay">
                        <span>🔗 Baca</span>
                    </div>
                </div>
                <div class="book-content">
                    <h2 class="book-title"><%= item.title %></h2>
                </div>
            </a>
        <% }) %>
    </div>
</div>