<% css = `<link rel="stylesheet" href="/css/proker.css">`%>


<section class="whatsin">
    <div class="container">
        <header class="whatsin-header">
            <span class="subtitle">
               WHAT'S IN
            </span>
            <h1>
               Update & Insight
            </h1>
            <p>
               Temukan seluruh update, insight,
               serta aktivitas terbaru UKM ITC.
           </p>
        </header>

        <div class="timeline">
            <% let currentYear = null; %>
            <% posts.forEach(post=>{ %>
                <% if(currentYear !== post.year){ %>
                    <% currentYear = post.year; %>
                    <div class="timeline-year">
                        <span><%= post.year %></span>
                    </div>
                <% } %>

                <article class="timeline-item">
                    <div class="timeline-dot"></div>

                    <div class="timeline-card">
                        <div class="card-top">
                            <span class="date">
                                <%= post.date %>
                            </span>
                            <span class="badge">
                                <%= post.format %>
                            </span>
                        </div>
                        <h3>
                            <%= post.title %>
                        </h3>
                        <div class="embed">
                            <iframe
                               src="<%= post.embed %>"
                               loading="lazy"
                               allowtransparency="true">
                            </iframe>
                        </div>
                        <a
                           href="<%= post.url %>"
                           target="_blank"
                           class="visit">
                            Lihat di Instagram →
                        </a>
                    </div>
                </article>
            <% }) %>
        </div>
    </div>
</section>

<script async src="//www.instagram.com/embed.js"></script>