<% css = '<link rel="stylesheet" href="/css/admin-add-blog.css">' %>

<section class="admin-form-section">
  <div class="admin-form-container">

    <div class="admin-form-header">
      <h1>Edit Artikel</h1>
    </div>

    <form action="/admin/edit/<%= blog._id %>" method="POST" enctype="multipart/form-data" class="admin-form">

      <div class="form-group">
        <label>Judul</label>
        <input type="text" name="title" value="<%= blog.title %>" required>
      </div>

      <div class="form-group">
        <img src="<%= blog.image %>" alt="Preview" width="200">
        <label>Upload Gambar</label>
        <input type="file" name="image" accept=".jpg,.jpeg,.png">
        <small class="char-info">Kosongkan jika tidak ingin mengganti gambar.</small>
      </div>

      <div class="form-group">
        <label>Kategori</label>
        <input type="text" name="category" value="<%= blog.category %>">
      </div>

      <div class="form-group">
        <label>Excerpt</label>
        <input type="text" name="excerpt" value="<%= blog.excerpt %>">
      </div>

      <div class="form-group">
        <label>Content</label>
        <textarea name="content" rows="10" required><%= blog.content %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-primary">Update</button>
        <a href="/admin/dashboard" class="btn-secondary">Batal</a>
      </div>

    </form>

  </div>
</section>